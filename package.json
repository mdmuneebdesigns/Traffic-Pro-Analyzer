{
  "name": "anpr-streamlit-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "python3 -m py_compile app.py database.py main.py api.py anpr_pipeline.py pages/*.py",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "express": "^5.2.1",
    "framer-motion": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "recharts": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "vite": "^8.0.8"
  }
}
